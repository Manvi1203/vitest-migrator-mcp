{
  "name": "vitest-migrator-mcp",
  "version": "1.0.0",
  "description": "MCP Server for AST-guided and AI-assisted Karma to Vitest migrations",
  "main": "dist/index.js",
  "bin": {
    "mcp-vitest-migrator": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/",
    "watch": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "ts-morph": "^25.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  }
}
